<UserControl x:Class="DraoxDemo.Views.ChannelListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DraoxDemo.ViewModels"
             xmlns:conv="clr-namespace:DraoxDemo.Converters"
             Background="{StaticResource BrushElevated}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolVis"/>
        <conv:StringNotEmptyToVisibilityConverter x:Key="StrVis"/>
    </UserControl.Resources>

    <DockPanel>
        <!-- Top bar -->
        <Border DockPanel.Dock="Top" Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Channels" FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource BrushText}" VerticalAlignment="Center"/>

                <!-- Search -->
                <Border Grid.Column="2" Background="{StaticResource BrushInput}" CornerRadius="4">
                    <Grid>
                        <TextBlock Text="🔍 Search..." Foreground="{StaticResource BrushTextMuted}"
                                   Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12"
                                   Visibility="{Binding SearchText, Converter={StaticResource StrVis},
                                               ConverterParameter=invert}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource BrushText}" Padding="10,6"
                                 CaretBrush="{StaticResource BrushText}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- New Channel button -->
                <Button Grid.Column="4" Content="+ New Channel" Command="{Binding ToggleCreatePanelCommand}"
                        Style="{StaticResource ButtonAccent}" Padding="14,8"/>
            </Grid>
        </Border>

        <!-- Error banner -->
        <Border DockPanel.Dock="Top" Background="#33ED4245" Padding="12,6"
                Visibility="{Binding ErrorMessage, Converter={StaticResource StrVis}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource BrushDanger}" FontSize="12"/>
        </Border>

        <!-- Create panel -->
        <Border DockPanel.Dock="Top" Background="{StaticResource BrushSurface}"
                Padding="16,12" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1"
                Visibility="{Binding ShowCreatePanel, Converter={StaticResource BoolVis}}">
            <StackPanel>
                <TextBlock Text="New Channel" Style="{StaticResource LabelBold}" Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Style="{StaticResource TextBoxDark}"
                             Text="{Binding NewChannelName, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Name" ToolTip="Channel name"/>
                    <TextBox Grid.Column="2" Style="{StaticResource TextBoxDark}"
                             Text="{Binding NewChannelDesc, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Description (optional)"/>
                    <Button Grid.Column="4" Content="Create" Command="{Binding CreateCommand}"
                            Style="{StaticResource ButtonAccent}" Padding="14,8"/>
                    <Button Grid.Column="6" Content="Cancel" Command="{Binding ToggleCreatePanelCommand}"
                            Style="{StaticResource ButtonGhost}" Padding="14,8"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Channel list -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,4">
                <!-- Loading indicator -->
                <TextBlock Text="Loading..." Foreground="{StaticResource BrushTextMuted}"
                           Margin="16,12" Visibility="{Binding IsLoading, Converter={StaticResource BoolVis}}"/>

                <ItemsControl ItemsSource="{Binding FilteredChannels}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="Transparent" Margin="8,2" Padding="12,10"
                                    CornerRadius="6" Cursor="Hand">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{StaticResource BrushHover}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Icon -->
                                    <TextBlock Grid.Column="0" Text="{Binding TypeIcon}"
                                               FontSize="16" VerticalAlignment="Center"
                                               Foreground="{StaticResource BrushTextMuted}"/>

                                    <!-- Info -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource LabelBold}"/>
                                            <!-- Type badge -->
                                            <Border Background="{StaticResource BrushInput}" CornerRadius="3"
                                                    Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TypeLabel}" FontSize="10"
                                                           Foreground="{StaticResource BrushTextMuted}"/>
                                            </Border>
                                            <!-- Frozen badge -->
                                            <Border Background="#33FAA61A" CornerRadius="3"
                                                    Padding="5,1" Margin="4,0,0,0" VerticalAlignment="Center"
                                                    Visibility="{Binding Frozen, Converter={StaticResource BoolVis}}">
                                                <TextBlock Text="❄ Frozen" FontSize="10"
                                                           Foreground="{StaticResource BrushWarning}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,2,0,0">
                                            <Run Text="{Binding Description}"/>
                                            <Run Text=" • "/>
                                            <Run Text="{Binding SubscriberCount}"/>
                                            <Run Text=" subscribers"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Action buttons -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Join/Leave -->
                                        <Button Style="{StaticResource ButtonGhost}" Padding="10,5" Margin="0,0,4,0"
                                                Visibility="{Binding IsSubscribed, Converter={StaticResource InvBoolVis}}"
                                                Command="{Binding DataContext.JoinCommand,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Id}">
                                            <TextBlock Text="Join" Foreground="{StaticResource BrushSuccess}"/>
                                        </Button>
                                        <Button Style="{StaticResource ButtonGhost}" Padding="10,5" Margin="0,0,4,0"
                                                Visibility="{Binding IsSubscribed, Converter={StaticResource BoolVis}}"
                                                Command="{Binding DataContext.LeaveCommand,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Id}">
                                            <TextBlock Text="Leave" Foreground="{StaticResource BrushTextMuted}"/>
                                        </Button>

                                        <!-- Open chat -->
                                        <Button Style="{StaticResource ButtonAccent}" Padding="10,5" Margin="0,0,4,0"
                                                Command="{Binding DataContext.OpenChatCommand,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="→ Open"/>
                                        </Button>

                                        <!-- Delete -->
                                        <Button Style="{StaticResource ButtonGhost}" Padding="8,5"
                                                Command="{Binding DataContext.DeleteCommand,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Id}"
                                                IsEnabled="{Binding IsSystem, Converter={StaticResource InvBoolVis}}">
                                            <TextBlock Text="🗑" Foreground="{StaticResource BrushDanger}"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
