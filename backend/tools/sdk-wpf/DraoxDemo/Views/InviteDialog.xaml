<Window x:Class="DraoxDemo.Views.InviteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:DraoxDemo.Converters"
        Title="Invite Users"
        Width="460" Height="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushSurface}"
        Foreground="{StaticResource BrushText}"
        FontFamily="{StaticResource FontMain}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <conv:StringNotEmptyToVisibilityConverter x:Key="StrVis"/>
    </Window.Resources>

    <DockPanel Margin="0">
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="{StaticResource BrushElevated}"
                Padding="20,14" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Style="{StaticResource LabelBold}" FontSize="16">
                    <Run Text="Invite to "/>
                    <Run Text="{Binding TargetName}" Foreground="{StaticResource BrushAccent}"/>
                </TextBlock>
                <TextBlock Text="Users who have posted in #general" FontSize="12"
                           Foreground="{StaticResource BrushTextMuted}" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Footer buttons -->
        <Border DockPanel.Dock="Bottom" Padding="20,12"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}"
                           Foreground="{StaticResource BrushTextMuted}" FontSize="12"
                           VerticalAlignment="Center"
                           Visibility="{Binding StatusMessage, Converter={StaticResource StrVis}}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Cancel" Style="{StaticResource ButtonGhost}" Padding="14,8"
                            Margin="0,0,8,0" Click="Cancel_Click"/>
                    <Button Style="{StaticResource ButtonAccent}" Padding="14,8"
                            Command="{Binding InviteCommand}" Click="Invite_Click">
                        <TextBlock>
                            <Run Text="Invite ("/>
                            <Run Text="{Binding SelectedCount}"/>
                            <Run Text=")"/>
                        </TextBlock>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Search + list -->
        <StackPanel DockPanel.Dock="Top" Margin="20,12,20,0">
            <Border Background="{StaticResource BrushInput}" CornerRadius="4" Margin="0,0,0,8">
                <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                         Background="Transparent" BorderThickness="0"
                         Foreground="{StaticResource BrushText}" Padding="10,8"
                         CaretBrush="{StaticResource BrushText}"/>
            </Border>
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" Text="Loading users..."
                   Foreground="{StaticResource BrushTextMuted}" Margin="20,8"
                   Visibility="{Binding IsLoading, Converter={StaticResource BoolVis}}"/>

        <ScrollViewer Margin="0,0,0,0" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="UserList" ItemsSource="{Binding FilteredUsers}" Margin="12,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12,8" Margin="4,1" CornerRadius="4" Cursor="Hand"
                                MouseLeftButtonDown="UserRow_Click">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource BrushHover}"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Background" Value="#1A5865F2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16"
                                        Background="{StaticResource BrushAccent}">
                                    <TextBlock Text="{Binding Username[0]}" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontWeight="Bold"/>
                                </Border>
                                <TextBlock Grid.Column="2" Text="{Binding Username}"
                                           Style="{StaticResource LabelNormal}" VerticalAlignment="Center"/>
                                <CheckBox Grid.Column="3" IsChecked="{Binding IsSelected}"
                                          Style="{StaticResource CheckBoxDark}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
