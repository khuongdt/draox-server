<Window x:Class="DraoxDemo.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DraoxDemo.ViewModels"
        xmlns:views="clr-namespace:DraoxDemo.Views"
        Title="Draox Demo"
        Width="1100" Height="700"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBackground}"
        Foreground="{StaticResource BrushText}"
        FontFamily="{StaticResource FontMain}">

    <Window.Resources>
        <!-- DataTemplate mapping: ViewModel → View -->
        <DataTemplate DataType="{x:Type vm:ChannelListViewModel}">
            <views:ChannelListView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ChatViewModel}">
            <views:ChatView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ClanListViewModel}">
            <views:ClanListView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ClanDetailViewModel}">
            <views:ClanDetailView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ServerInfoViewModel}">
            <views:ServerInfoView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="64"/>    <!-- Icon sidebar -->
            <ColumnDefinition Width="*"/>     <!-- Content -->
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource BrushBackground}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,8">
                    <!-- Disconnect -->
                    <Button Command="{Binding DisconnectCommand}" Style="{StaticResource ButtonGhost}"
                            Width="48" Height="48" Margin="8,4" ToolTip="Disconnect">
                        <TextBlock Text="⏻" FontSize="20"/>
                    </Button>
                </StackPanel>

                <StackPanel Margin="0,16,0,0">
                    <!-- App logo -->
                    <Border Width="40" Height="40" Margin="12,0,12,16"
                            Background="{StaticResource BrushAccent}" CornerRadius="12">
                        <TextBlock Text="◈" FontSize="20" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Separator line -->
                    <Border Height="2" Background="{StaticResource BrushBorder}" Margin="8,0,8,12"/>

                    <!-- Channels nav -->
                    <Button Command="{Binding NavigateToCommand}" CommandParameter="{x:Static vm:NavItem.Channels}"
                            Style="{StaticResource ButtonGhost}" Width="48" Height="48" Margin="8,4"
                            ToolTip="Channels">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" CornerRadius="12" Width="48" Height="48">
                                    <TextBlock Text="💬" FontSize="22"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding CurrentNav}" Value="{x:Static vm:NavItem.Channels}">
                                        <Setter TargetName="Bg" Property="Background" Value="{StaticResource BrushAccent}"/>
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{StaticResource BrushHover}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Clans nav -->
                    <Button Command="{Binding NavigateToCommand}" CommandParameter="{x:Static vm:NavItem.Clans}"
                            Style="{StaticResource ButtonGhost}" Width="48" Height="48" Margin="8,4"
                            ToolTip="Clans">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" CornerRadius="12" Width="48" Height="48">
                                    <TextBlock Text="👥" FontSize="22"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding CurrentNav}" Value="{x:Static vm:NavItem.Clans}">
                                        <Setter TargetName="Bg" Property="Background" Value="{StaticResource BrushAccent}"/>
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{StaticResource BrushHover}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Server Info nav -->
                    <Button Command="{Binding NavigateToCommand}" CommandParameter="{x:Static vm:NavItem.ServerInfo}"
                            Style="{StaticResource ButtonGhost}" Width="48" Height="48" Margin="8,4"
                            ToolTip="Server Info">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" CornerRadius="12" Width="48" Height="48">
                                    <TextBlock Text="ℹ" FontSize="22"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding CurrentNav}" Value="{x:Static vm:NavItem.ServerInfo}">
                                        <Setter TargetName="Bg" Property="Background" Value="{StaticResource BrushAccent}"/>
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{StaticResource BrushHover}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Content area -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentView}"
                        Background="{StaticResource BrushElevated}"/>
    </Grid>
</Window>
