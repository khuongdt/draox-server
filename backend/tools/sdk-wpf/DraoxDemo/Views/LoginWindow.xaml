<Window x:Class="DraoxDemo.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DraoxDemo.ViewModels"
        xmlns:conv="clr-namespace:DraoxDemo.Converters"
        Title="Draox Demo — Login"
        Width="480" Height="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BrushBackground}"
        Foreground="{StaticResource BrushText}"
        FontFamily="{StaticResource FontMain}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolVis"/>
    </Window.Resources>

    <Grid Margin="40,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center">
            <TextBlock Text="◈ DRAOX DEMO" FontSize="28" FontWeight="Bold"
                       Foreground="{StaticResource BrushAccent}" HorizontalAlignment="Center"/>
            <TextBlock Text="Socket Demo Client" FontSize="13"
                       Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Server Config Box -->
        <Border Grid.Row="2" Background="{StaticResource BrushSurface}" CornerRadius="8" Padding="16">
            <StackPanel>
                <TextBlock Text="SERVER CONFIGURATION" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,12"/>

                <!-- Host + Port row -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="72"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Host" Style="{StaticResource LabelMuted}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource TextBoxDark}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Port" Style="{StaticResource LabelMuted}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding CurrentPort, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource TextBoxDark}"/>
                    </StackPanel>
                </Grid>

                <!-- Protocol selector -->
                <TextBlock Text="Protocol" Style="{StaticResource LabelMuted}" Margin="0,0,0,6"/>
                <StackPanel Margin="0,0,0,4">

                    <!-- TCP — GroupName removed; mutual exclusion handled by ViewModel -->
                    <RadioButton IsChecked="{Binding ProtocolTcp}"
                                 Style="{StaticResource RadioButtonDark}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="TCP" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="Reliable · ordered delivery"
                                           FontSize="11" Foreground="{StaticResource BrushTextMuted}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding TcpPort, StringFormat=':{0}'}"
                                       FontFamily="Consolas" FontSize="12"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </Grid>
                    </RadioButton>

                    <!-- WebSocket -->
                    <RadioButton IsChecked="{Binding ProtocolWs}"
                                 Style="{StaticResource RadioButtonDark}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="WebSocket" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="Frame-based · browser-friendly"
                                           FontSize="11" Foreground="{StaticResource BrushTextMuted}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding WsPort, StringFormat=':{0}'}"
                                       FontFamily="Consolas" FontSize="12"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </Grid>
                    </RadioButton>

                    <!-- UDP -->
                    <RadioButton IsChecked="{Binding ProtocolUdp}"
                                 Style="{StaticResource RadioButtonDark}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="UDP" FontWeight="SemiBold" FontSize="13"/>
                                    <Border Background="#33FAA61A" CornerRadius="3"
                                            Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="⚠ limited" FontSize="10"
                                                   Foreground="{StaticResource BrushWarning}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Stateless · no session resume"
                                           FontSize="11" Foreground="{StaticResource BrushTextMuted}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding UdpPort, StringFormat=':{0}'}"
                                       FontFamily="Consolas" FontSize="12"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </Grid>
                    </RadioButton>

                    <!-- UDP warning banner -->
                    <Border Background="#22FAA61A" CornerRadius="4" Padding="10,7" Margin="2,4,2,0"
                            Visibility="{Binding ShowUdpWarning, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="UDP has no guaranteed delivery, no heartbeat, and no session resume. Use TCP or WebSocket for reliable communication."
                                   Foreground="{StaticResource BrushWarning}" FontSize="11"
                                   TextWrapping="Wrap" LineHeight="16"/>
                    </Border>
                </StackPanel>

                <!-- TLS toggle -->
                <CheckBox Content="Use TLS / HTTPS" IsChecked="{Binding UseTls}"
                          Style="{StaticResource CheckBoxDark}" Margin="2,10,0,0">
                    <CheckBox.ToolTip>
                        <StackPanel>
                            <TextBlock Text="TCP  →  TLS on port 9000"/>
                            <TextBlock Text="WebSocket  →  wss:// on port 9002"/>
                            <TextBlock Text="Admin API  →  https:// on port 9100"/>
                        </StackPanel>
                    </CheckBox.ToolTip>
                </CheckBox>
            </StackPanel>
        </Border>

        <!-- Credentials -->
        <StackPanel Grid.Row="4">
            <TextBlock Text="Username" Style="{StaticResource LabelMuted}" Margin="0,0,0,4"/>
            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource TextBoxDark}" Margin="0,0,0,10"/>

            <TextBlock Text="Password" Style="{StaticResource LabelMuted}" Margin="0,0,0,4"/>
            <PasswordBox x:Name="PasswordBox" Style="{StaticResource PasswordBoxDark}"
                         PasswordChanged="PasswordBox_PasswordChanged"/>
        </StackPanel>

        <!-- Connect Button -->
        <Button Grid.Row="6"
                Command="{Binding ConnectCommand}"
                Style="{StaticResource ButtonAccent}"
                Height="42" FontSize="15">
            <Button.Content>
                <TextBlock>
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="Connect"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnecting}" Value="True">
                                    <Setter Property="Text" Value="Connecting..."/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Button.Content>
        </Button>

        <!-- Status -->
        <Border Grid.Row="8" CornerRadius="4" Padding="10,6" Margin="0,4,0,0"
                Visibility="{Binding StatusMessage, Converter={StaticResource BoolVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#33FFFFFF"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsError}" Value="True">
                            <Setter Property="Background" Value="#33ED4245"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding StatusMessage}" FontSize="12"
                       TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource BrushDanger}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>
    </Grid>
</Window>
