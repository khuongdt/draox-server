<UserControl x:Class="DraoxDemo.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DraoxDemo.ViewModels"
             xmlns:conv="clr-namespace:DraoxDemo.Converters"
             Background="{StaticResource BrushElevated}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolVis"/>
        <conv:StringNotEmptyToVisibilityConverter x:Key="StrVis"/>
        <conv:MessageAlignConverter x:Key="MsgAlign"/>
        <conv:MessageBubbleColorConverter x:Key="BubbleColor"/>
    </UserControl.Resources>

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="← Back" Command="{Binding BackCommand}"
                        Style="{StaticResource ButtonGhost}" Padding="10,6"/>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Channel.TypeIcon}" FontSize="16"
                                   Foreground="{StaticResource BrushTextMuted}" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding Channel.Name}" Style="{StaticResource LabelBold}" FontSize="16"/>
                        <Border Background="{StaticResource BrushInput}" CornerRadius="3"
                                Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding Channel.Frozen, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="❄ Frozen" FontSize="10" Foreground="{StaticResource BrushWarning}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,2,0,0">
                        <Run Text="{Binding Channel.Description}"/>
                        <Run Text=" • "/>
                        <Run Text="{Binding Channel.SubscriberCount}"/>
                        <Run Text=" subscribers"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Error banner -->
        <Border DockPanel.Dock="Top" Background="#33ED4245" Padding="12,6"
                Visibility="{Binding ErrorMessage, Converter={StaticResource StrVis}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource BrushDanger}" FontSize="12"/>
        </Border>

        <!-- Input area -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Padding="16,10">
            <StackPanel>
                <!-- Reply preview -->
                <Border Background="{StaticResource BrushInput}" CornerRadius="4" Padding="10,6"
                        Margin="0,0,0,6"
                        Visibility="{Binding ReplyToId, Converter={StaticResource StrVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Replying to:" FontSize="11"
                                       Foreground="{StaticResource BrushAccent}"/>
                            <TextBlock Text="{Binding ReplyToText}" FontSize="12"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Command="{Binding ClearReplyCommand}"
                                Style="{StaticResource ButtonGhost}" Padding="6,4"/>
                    </Grid>
                </Border>

                <!-- Toolbar + input row -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Toolbar buttons -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Style="{StaticResource ButtonGhost}" Padding="8,6" Margin="0,0,4,0"
                                ToolTip="Send image by URL" Click="ImageUrl_Click">
                            <TextBlock Text="🖼 Image"/>
                        </Button>
                    </StackPanel>

                    <!-- Text input -->
                    <TextBox Grid.Column="2" x:Name="MessageBox"
                             Text="{Binding MessageText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="False" VerticalAlignment="Center"
                             KeyDown="MessageBox_KeyDown">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource TextBoxDark}">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <VisualBrush Stretch="None" AlignmentX="Left">
                                                    <VisualBrush.Visual>
                                                        <TextBlock Text="Message..." Margin="12,0"
                                                                   Foreground="{StaticResource BrushTextMuted}"
                                                                   VerticalAlignment="Center"/>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <!-- Send button -->
                    <Button Grid.Column="4" Content="Send ▶" Command="{Binding SendCommand}"
                            Style="{StaticResource ButtonAccent}" Padding="16,8"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Typing indicator -->
        <Border DockPanel.Dock="Bottom" Padding="16,4"
                Visibility="{Binding TypingUsers.Count, Converter={StaticResource BoolVis}}">
            <TextBlock Foreground="{StaticResource BrushTextMuted}" FontSize="12" FontStyle="Italic">
                <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0} is typing...">
                        <Binding Path="TypingUsers[0]"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </Border>

        <!-- Messages area -->
        <Grid>
            <!-- Load more button -->
            <Button Content="↑ Load older messages" Command="{Binding LoadMoreCommand}"
                    Style="{StaticResource ButtonGhost}" HorizontalAlignment="Center"
                    VerticalAlignment="Top" Margin="0,8,0,0" Padding="16,6"
                    Visibility="{Binding HasMore, Converter={StaticResource BoolVis}}"
                    Panel.ZIndex="1"/>

            <ScrollViewer x:Name="ScrollView" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                <ItemsControl x:Name="MessageList" ItemsSource="{Binding Messages}"
                              Margin="0,36,0,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="8,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Bubble container aligned by IsOwn -->
                                <Border x:Name="BubbleContainer"
                                        Grid.Column="0" Grid.ColumnSpan="2"
                                        MaxWidth="460"
                                        HorizontalAlignment="{Binding IsOwn, Converter={StaticResource MsgAlign}}"
                                        Margin="0,2">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="↩ Reply"
                                                      Command="{Binding DataContext.SetReplyToCommand,
                                                          Source={x:Reference MessageList}}"
                                                      CommandParameter="{Binding}"/>
                                            <MenuItem Header="✏ Edit"
                                                      Command="{Binding DataContext.EditMessageCommand,
                                                          Source={x:Reference MessageList}}"
                                                      CommandParameter="{Binding}"
                                                      Visibility="{Binding IsOwn, Converter={StaticResource BoolVis}}"/>
                                            <MenuItem Header="🗑 Delete"
                                                      Command="{Binding DataContext.DeleteMessageCommand,
                                                          Source={x:Reference MessageList}}"
                                                      CommandParameter="{Binding Id}"
                                                      Visibility="{Binding IsOwn, Converter={StaticResource BoolVis}}"/>
                                            <Separator/>
                                            <MenuItem Header="👍"
                                                      Command="{Binding DataContext.ReactCommand,
                                                          Source={x:Reference MessageList}}"
                                                      CommandParameter="{Binding Id, Converter={StaticResource BubbleColor}}"/>
                                            <MenuItem Header="React 👍"
                                                      CommandParameter="{Binding}"
                                                      Tag="👍">
                                                <MenuItem.Command>
                                                    <Binding Path="DataContext.ReactCommand"
                                                             Source="{x:Reference MessageList}"/>
                                                </MenuItem.Command>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Border.ContextMenu>

                                    <StackPanel>
                                        <!-- Sender name + time (hide for own messages) -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2"
                                                    HorizontalAlignment="{Binding IsOwn, Converter={StaticResource MsgAlign}}"
                                                    Visibility="{Binding IsOwn, Converter={StaticResource InvBoolVis}}">
                                            <TextBlock Text="{Binding SenderName}"
                                                       Foreground="{StaticResource BrushAccent}"
                                                       FontWeight="SemiBold" FontSize="12" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding CreatedAt, StringFormat=HH:mm}"
                                                       Foreground="{StaticResource BrushTextMuted}" FontSize="11"/>
                                        </StackPanel>

                                        <!-- Message bubble -->
                                        <Border CornerRadius="12" Padding="12,8"
                                                Background="{Binding IsOwn, Converter={StaticResource BubbleColor}}">
                                            <StackPanel>
                                                <!-- Text content -->
                                                <TextBlock Text="{Binding DisplayText}"
                                                           Foreground="{StaticResource BrushText}"
                                                           TextWrapping="Wrap" FontSize="14"
                                                           Visibility="{Binding IsImage, Converter={StaticResource InvBoolVis}}"/>
                                                <!-- Image content -->
                                                <StackPanel Visibility="{Binding IsImage, Converter={StaticResource BoolVis}}">
                                                    <Image x:Name="MsgImage" MaxWidth="320" MaxHeight="240"
                                                           Stretch="Uniform" Margin="0,4,0,4"
                                                           Source="{Binding ImageUrl}"
                                                           ToolTip="{Binding ImageUrl}"/>
                                                    <TextBlock Text="{Binding ImageUrl}"
                                                               Foreground="{StaticResource BrushAccent}"
                                                               FontSize="11" TextWrapping="Wrap"
                                                               TextDecorations="Underline" Cursor="Hand"/>
                                                </StackPanel>

                                                <!-- Reactions -->
                                                <ItemsControl ItemsSource="{Binding Reactions}"
                                                              Margin="0,4,0,0"
                                                              Visibility="{Binding Reactions.Count, Converter={StaticResource BoolVis}}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{StaticResource BrushInput}"
                                                                    CornerRadius="8" Padding="6,2" Margin="0,0,4,0">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding Emoji}" FontSize="12"/>
                                                                    <TextBlock Text="{Binding Count}"
                                                                               Foreground="{StaticResource BrushTextMuted}"
                                                                               FontSize="11" Margin="4,0,0,0"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <!-- Timestamp for own messages -->
                                        <TextBlock Text="{Binding CreatedAt, StringFormat=HH:mm}"
                                                   Foreground="{StaticResource BrushTextMuted}" FontSize="11"
                                                   HorizontalAlignment="Right" Margin="0,2,4,0"
                                                   Visibility="{Binding IsOwn, Converter={StaticResource BoolVis}}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
