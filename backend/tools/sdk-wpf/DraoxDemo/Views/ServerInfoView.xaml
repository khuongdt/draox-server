<UserControl x:Class="DraoxDemo.Views.ServerInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DraoxDemo.Converters"
             Background="{StaticResource BrushElevated}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <conv:StringNotEmptyToVisibilityConverter x:Key="StrVis"/>
    </UserControl.Resources>

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <TextBlock Text="Server Info" FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource BrushText}" VerticalAlignment="Center"/>
                <Button Content="↻ Refresh" Command="{Binding LoadCommand}"
                        Style="{StaticResource ButtonGhost}" Padding="12,6"
                        HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- Error banner -->
        <Border DockPanel.Dock="Top" Background="#33ED4245" Padding="12,6"
                Visibility="{Binding ErrorMessage, Converter={StaticResource StrVis}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource BrushDanger}" FontSize="12"/>
        </Border>

        <!-- Loading -->
        <TextBlock DockPanel.Dock="Top" Text="Loading..." Foreground="{StaticResource BrushTextMuted}"
                   Margin="20,16" Visibility="{Binding IsLoading, Converter={StaticResource BoolVis}}"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,16">
                <!-- Connection info -->
                <Border Background="{StaticResource BrushSurface}" CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Connection" Style="{StaticResource LabelBold}" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Connected as:"
                                       Foreground="{StaticResource BrushTextMuted}" FontSize="12"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ConnectedAs}"
                                       Style="{StaticResource LabelNormal}"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Server URL:"
                                       Foreground="{StaticResource BrushTextMuted}" FontSize="12"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ServerUrl}"
                                       Foreground="{StaticResource BrushAccent}" FontSize="12"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Health status -->
                <Border Background="{StaticResource BrushSurface}" CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Health" Style="{StaticResource LabelBold}" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border Width="10" Height="10" CornerRadius="5" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource BrushTextMuted}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Health.Status}" Value="healthy">
                                                <Setter Property="Background" Value="{StaticResource BrushSuccess}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Health.Status}" Value="degraded">
                                                <Setter Property="Background" Value="{StaticResource BrushWarning}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <TextBlock Text="{Binding Health.Status, FallbackValue='unknown'}"
                                       Style="{StaticResource LabelNormal}" FontSize="14"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Server info -->
                <Border Background="{StaticResource BrushSurface}" CornerRadius="8" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="Server Details" Style="{StaticResource LabelBold}" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Version:"
                                       Foreground="{StaticResource BrushTextMuted}" FontSize="12"/>
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       Text="{Binding ServerInfo.Version, FallbackValue='—'}"
                                       Style="{StaticResource LabelNormal}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Uptime:"
                                       Foreground="{StaticResource BrushTextMuted}" FontSize="12"/>
                            <TextBlock Grid.Row="2" Grid.Column="1"
                                       Text="{Binding ServerInfo.UptimeFormatted, FallbackValue='—'}"
                                       Style="{StaticResource LabelNormal}"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Connections:"
                                       Foreground="{StaticResource BrushTextMuted}" FontSize="12"/>
                            <TextBlock Grid.Row="4" Grid.Column="1"
                                       Text="{Binding ServerInfo.ActiveConnections, FallbackValue='—'}"
                                       Style="{StaticResource LabelNormal}"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Environment:"
                                       Foreground="{StaticResource BrushTextMuted}" FontSize="12"/>
                            <TextBlock Grid.Row="6" Grid.Column="1"
                                       Text="{Binding ServerInfo.Environment, FallbackValue='—'}"
                                       Style="{StaticResource LabelNormal}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
